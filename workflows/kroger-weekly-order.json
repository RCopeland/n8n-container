            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Parse sync RESULT": {
      "main": [
        [
          {
            "node": "Sync OK?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Sync OK?": {
      "main": [
        [
          {
            "node": "Fill Kroger cart (cart.py)",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Email: failure",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fill Kroger cart (cart.py)": {
      "main": [
        [
          {
            "node": "Parse cart RESULT",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Parse cart RESULT": {
      "main": [
        [
          {
            "node": "Cart OK?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Cart OK?": {
      "main": [
