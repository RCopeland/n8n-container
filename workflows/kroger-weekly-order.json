{
  "name": "Kroger Weekly Order (Sunday)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 8 * * 0"
            }
          ]
        }
      },
      "id": "sched-sunday",
      "name": "Sunday 8am",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "command": "python3 /opt/food/tandoor/sync_tandoor.py --json 2>&1"
      },
      "id": "exec-sync",
      "name": "Generate delivery list (sync_tandoor)",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [220, 0]
    },
    {
      "parameters": {
        "jsCode": "const stdout = $input.first().json.stdout || '';\nconst m = stdout.match(/RESULT: (\\{.*\\})/);\nlet data = null;\nif (m) { try { data = JSON.parse(m[1]); } catch (e) {} }\nreturn [{ json: { ok: !!(data && data.ok), data, exitCode: $input.first().json.exitCode, raw: stdout } }];"
      },
      "id": "code-parse-sync",
      "name": "Parse sync RESULT",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [440, 0]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "cond-sync-ok",
              "leftValue": "={{ $json.ok }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ]
        }
      },
      "id": "if-sync-ok",
      "name": "Sync OK?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [660, 0]
    },
    {
      "parameters": {
        "command": "python3 /opt/food/kroger/cart.py --json 2>&1"
      },
      "id": "exec-cart",
      "name": "Fill Kroger cart (cart.py)",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [900, -140]
    },
    {
      "parameters": {
        "jsCode": "const stdout = $input.first().json.stdout || '';\nconst m = stdout.match(/RESULT: (\\{.*\\})/);\nlet data = null;\nif (m) { try { data = JSON.parse(m[1]); } catch (e) {} }\nreturn [{ json: { ok: !!(data && data.ok), data, exitCode: $input.first().json.exitCode, raw: stdout } }];"
      },
      "id": "code-parse-cart",
      "name": "Parse cart RESULT",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1120, -140]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "cond-cart-ok",
              "leftValue": "={{ $json.ok }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ]
        }
      },
      "id": "if-cart-ok",
      "name": "Cart OK?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [1340, -140]
    },
    {
      "parameters": {
        "fromEmail": "REPLACE-FROM-ADDRESS",
        "toEmail": "REPLACE-TO-ADDRESS",
        "subject": "Kroger order ready — review in the app",
        "emailFormat": "text",
        "text": "Weekly Kroger order is ready for review.\n\nSync (meal plan -> delivery list):\n{{ $('Parse sync RESULT').item.json.raw }}\n\nCart fill (cart.py):\n{{ $('Parse cart RESULT').item.json.raw }}\n\n1. Open the Kroger app / website\n2. Adjust produce quantities\n3. Confirm substitutions and checkout\n4. Schedule delivery/pickup"
      },
      "id": "email-success",
      "name": "Email: order ready",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2,
      "position": [1580, -260],
      "credentials": {
        "emailSmtp": {
          "id": "",
          "name": "smtp-food"
        }
      }
    },
    {
      "parameters": {
        "fromEmail": "REPLACE-FROM-ADDRESS",
        "toEmail": "REPLACE-TO-ADDRESS",
        "subject": "Kroger weekly order FAILED",
        "emailFormat": "text",
        "text": "The weekly order pipeline failed.\n\nOutput:\n{{ $json.raw }}\n\nCheck the n8n execution log for details, fix the cause, and re-run this workflow."
      },
      "id": "email-fail",
      "name": "Email: failure",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2,
      "position": [1580, 140],
      "credentials": {
        "emailSmtp": {
          "id": "",
          "name": "smtp-food"
        }
      }
    }
  ],
  "connections": {
    "Sunday 8am": {
      "main": [
        [
          {
            "node": "Generate delivery list (sync_tandoor)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Generate delivery list (sync_tandoor)": {
      "main": [
        [
          {
