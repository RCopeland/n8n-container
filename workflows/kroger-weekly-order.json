{
  "name": "Kroger Weekly Order (Sunday)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 8 * * 0"
            }
          ]
        }
      },
      "id": "sched-sunday",
      "name": "Sunday 8am",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://127.0.0.1:8731/run",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\"cmd\":\"sync\"}",
        "options": {
          "timeout": 900000
        }
      },
      "id": "http-sync",
      "name": "Run sync_tandoor (food-runner)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const stdout = $input.first().json.stdout || '';\nconst m = stdout.match(/RESULT: (\\{.*\\})/);\nlet data = null;\nif (m) { try { data = JSON.parse(m[1]); } catch (e) {} }\nreturn [{ json: { ok: !!(data && data.ok), data, exitCode: $input.first().json.exitCode, raw: stdout } }];"
      },
      "id": "code-parse-sync",
      "name": "Parse sync RESULT",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "cond-sync-ok",
              "leftValue": "={{ $json.ok }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ]
        }
      },
      "id": "if-sync-ok",
      "name": "Sync OK?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        660,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://127.0.0.1:8731/run",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\"cmd\":\"cart\"}",
        "options": {
          "timeout": 900000
        }
      },
      "id": "http-cart",
      "name": "Fill Kroger cart (food-runner)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        900,
