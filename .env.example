# Tailscale pre-auth key: https://login.tailscale.com/admin/settings/keys
# (reusable, user-attached). The container joins the tailnet as "n8n".
TS_AUTHKEY=

# MagicDNS name of this node, used by ts-serve.json for the HTTPS cert.
TS_CERT_DOMAIN=n8n.tail4fde5e.ts.net

# Public webhook base URL (must match the serve URL above).
N8N_WEBHOOK_URL=https://n8n.tail4fde5e.ts.net/
